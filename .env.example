# Copy to .env and adjust if your ports differ.

# --- MongoDB ---
# The API needs a replica set because issues, returns and corrections are written
# inside multi-document transactions. docker-compose.yml starts a single-node one.
MONGODB_URI=mongodb://localhost:27017/equipment_ledger?replicaSet=rs0&directConnection=true
# Separate database for the automated tests. It is wiped before every test file.
MONGODB_TEST_URI=mongodb://localhost:27017/equipment_ledger_test?replicaSet=rs0&directConnection=true

# --- The site's clock ---
# One construction site keeps one clock. Both sides format every time on this zone, so a refusal
# the API writes and a screen the keeper reads always name the same day and hour. Any IANA name.
# UTC is the default because the seeded demo then reads the same on screen as in the raw
# documents; a real site would set its own, e.g. Europe/London.
SITE_TIMEZONE=UTC
NEXT_PUBLIC_SITE_TIMEZONE=UTC

# --- API (NestJS) ---
API_PORT=4000
# Origins allowed by CORS, comma separated. Must include wherever the Next.js app is served from.
WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js) ---
# Where the browser and the Next.js server reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Seed ---
# Optional. Pins the seed's "today" so the same command produces the same store on any day.
# Format: YYYY-MM-DD (UTC). Leave unset to anchor on the day you run it.
# SEED_ANCHOR_DATE=2026-09-10
